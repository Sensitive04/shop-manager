# Connection string for MongoDB.
#
# A replica set is required — multi-document transactions do not exist on a
# standalone server, and POS checkout depends on them. Any single-node set will
# do:
#
#   docker compose (see docker-compose.yml):
#   MONGODB_URI=mongodb://admin:admin@mongo:27017/shopmanager?replicaSet=rs0&authSource=admin
#
#   MongoDB Atlas (Netlify deployment):
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# When running `npm run dev` with no MONGODB_URI set, the app starts an
# in-process single-node replica set via mongodb-memory-server, so you do
# not need a local MongoDB install. Data is discarded when the dev server
# stops.
MONGODB_URI=

# Database name.
#
# Only needed when the connection string does not include one. Atlas connection
# strings usually end in a bare `/`, which leaves the database unset — without
# this, the driver would quietly write every sale to a database called `test`.
MONGODB_DB_NAME=shopmanager

# Set to "false" to disable the mongodb-memory-server fallback entirely and
# fail loudly instead if MONGODB_URI is unset.
MONGODB_MEMORY_FALLBACK=true

# Default expiry-alert window, in days.
EXPIRY_ALERT_DAYS=30

# Currency label shown throughout the UI.
CURRENCY_SYMBOL=$